<section id="contact" class="bg-gray-300 border-b-4 border-b-gray-1200">
  <div class="center region">
    <div class="box flow prose">
      <h2 class="mt-zero">Tell us about your project</h2>
      <p>
        Share what you're working on and where you need help. We'll reply within
        a few days. Prefer to talk it through? <a
          href="https://tidycal.com/frankstallone/hoverboard"
          target="_blank"
          aria-label="Book a call — opens in a new tab">Book a call</a
        >.
      </p>

      <div
        id="contact-form-status"
        class="form-status flow"
        tabindex="-1"
        hidden
      >
      </div>

      <form
        name="main"
        netlify-honeypot="bot-field"
        class="contact-form switcher"
        method="POST"
        data-netlify="true"
        data-contact-form
        action="/contact/success/"
      >
        <input type="hidden" name="form-name" value="main" />
        <input type="hidden" name="subject" value="Form: hoverboardmedia.com" />
        <p class="hidden" aria-hidden="true">
          <label for="bot-field">Do you like delicious treats?</label>
          <input
            name="bot-field"
            id="bot-field"
            tabindex="-1"
            autocomplete="off"
          />
        </p>

        <span class="stack">
          <label for="name">Name</label>
          <input
            id="name"
            class="text-blue-1000 border-gray-700 border-1 border-solid"
            name="name"
            type="text"
            autocomplete="name"
            required
            aria-required="true"
            aria-describedby="name-error"
            data-form-field
            data-field-name="Name"
          />
          <span id="name-error" class="form-error" hidden></span>
        </span>

        <span class="stack">
          <label for="email">Email</label>
          <input
            id="email"
            class="text-blue-1000 border-gray-700 border-1 border-solid"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            aria-required="true"
            aria-describedby="email-error"
            data-form-field
            data-field-name="Email"
          />
          <span id="email-error" class="form-error" hidden></span>
        </span>

        <span class="stack">
          <label for="tel">Phone number <small>(optional)</small></label>
          <input
            id="tel"
            class="text-blue-1000 border-gray-700 border-1 border-solid"
            name="tel"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            aria-describedby="tel-error"
            data-form-field
            data-field-name="Phone number"
          />
          <span id="tel-error" class="form-error" hidden></span>
        </span>

        <span class="stack">
          <label for="message">Message</label>
          <textarea
            name="message"
            id="message"
            class="text-blue-1000 border-gray-700 border-1 border-solid"
            rows="6"
            required
            aria-required="true"
            aria-describedby="message-error"
            data-form-field
            data-field-name="Message"></textarea>
          <span id="message-error" class="form-error" hidden></span>
        </span>

        <button type="submit" id="formSubmit" class="button">
          Send project inquiry
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('#contact-form-status');
  const submitButton = form?.querySelector<HTMLButtonElement>('#formSubmit');
  const fields = form
    ? Array.from(
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          '[data-form-field]',
        ),
      )
    : [];

  const getErrorElement = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const errorId = field.getAttribute('aria-describedby');
    return errorId ? document.getElementById(errorId) : null;
  };

  const getValidationMessage = (
    field: HTMLInputElement | HTMLTextAreaElement,
  ) => {
    const fieldName = field.dataset.fieldName ?? 'This field';

    if (field.validity.valueMissing) {
      return `${fieldName} is required.`;
    }

    if (field.validity.typeMismatch && field.type === 'email') {
      return 'Enter an email address in the format name@example.com.';
    }

    return field.validationMessage || `Check ${fieldName.toLowerCase()}.`;
  };

  const showFieldError = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const error = getErrorElement(field);
    field.setAttribute('aria-invalid', 'true');

    if (error) {
      error.textContent = getValidationMessage(field);
      error.hidden = false;
    }
  };

  const clearFieldError = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const error = getErrorElement(field);
    field.removeAttribute('aria-invalid');

    if (error) {
      error.textContent = '';
      error.hidden = true;
    }
  };

  const showStatus = (
    state: 'validation' | 'pending' | 'error' | 'success',
    heading: string,
    message: string,
    shouldFocus = false,
  ) => {
    if (!status) return;

    status.dataset.state = state;
    status.setAttribute(
      'role',
      state === 'error' || state === 'validation' ? 'alert' : 'status',
    );
    status.setAttribute(
      'aria-live',
      state === 'error' || state === 'validation' ? 'assertive' : 'polite',
    );
    const statusHeading = document.createElement('h3');
    const statusMessage = document.createElement('p');
    statusHeading.textContent = heading;
    statusMessage.textContent = message;
    status.replaceChildren(statusHeading, statusMessage);
    status.hidden = false;

    if (shouldFocus) {
      status.focus();
    }
  };

  let validationTimer = 0;

  form?.addEventListener(
    'invalid',
    (event) => {
      const field = event.target;
      if (
        !(
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement
        )
      ) {
        return;
      }

      showFieldError(field);
      window.clearTimeout(validationTimer);
      validationTimer = window.setTimeout(() => {
        const invalidFields = fields.filter(
          (candidate) => !candidate.validity.valid,
        );
        const count = invalidFields.length;
        showStatus(
          'validation',
          'Check your details',
          `${count} ${count === 1 ? 'field needs' : 'fields need'} your attention. Your answers have not been cleared.`,
        );
      }, 0);
    },
    true,
  );

  fields.forEach((field) => {
    field.addEventListener('input', () => {
      if (field.validity.valid) {
        clearFieldError(field);
      }

      if (
        status?.dataset.state === 'validation' &&
        fields.every((candidate) => candidate.validity.valid)
      ) {
        status.hidden = true;
      }
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitButton || !status) return;
    if (form.getAttribute('aria-busy') === 'true') return;

    fields.forEach(clearFieldError);
    form.setAttribute('aria-busy', 'true');
    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    showStatus(
      'pending',
      'Sending your inquiry',
      'Keep this page open for a moment.',
    );

    const payload = new URLSearchParams();
    new FormData(form).forEach((value, key) => {
      if (typeof value === 'string') {
        payload.append(key, value);
      }
    });

    const controller = new AbortController();
    let didTimeOut = false;
    const timeout = window.setTimeout(() => {
      didTimeOut = true;
      controller.abort();
    }, 15000);

    try {
      if (!navigator.onLine) {
        throw new Error('offline');
      }

      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: payload.toString(),
        signal: controller.signal,
      });

      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`);
      }

      form.reset();
      form.hidden = true;
      showStatus(
        'success',
        'Thanks—your inquiry is on its way',
        "We'll reply within a few days. You can safely close this page.",
        true,
      );
    } catch {
      const message = didTimeOut
        ? "The request is taking longer than expected. We couldn't confirm it was sent, and your answers are still here. Please check your connection before trying again."
        : "We couldn't confirm your inquiry was sent. Your answers are still here. Check your connection and try again, or use the booking link above.";

      showStatus('error', "We couldn't confirm your inquiry", message, true);
    } finally {
      window.clearTimeout(timeout);
      form.removeAttribute('aria-busy');

      if (!form.hidden) {
        submitButton.disabled = false;
        submitButton.textContent = 'Send project inquiry';
      }
    }
  });
</script>
